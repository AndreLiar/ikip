# ─────────────────────────────────────────────────────────────────────────
# Example environment — copy to .env and fill in. NEVER put real secrets here.
#   cp .env.example .env
# .env is gitignored; .env.example (this file) is committed as documentation.
# ─────────────────────────────────────────────────────────────────────────

# Cloudflare R2 (object storage, S3-compatible) — ADR 0014
# Create an R2 API token (Object Read & Write, scoped to the bucket) to get the keys.
R2_ACCOUNT_ID=your-account-id
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=ikip-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AI (remote) — Azure OpenAI / Foundry (ADR 0007, 0010)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Local infra (Docker Compose) — defaults for dev
DATABASE_URL=postgresql://ikip:ikip@localhost:5432/ikip
REDIS_URL=redis://localhost:6379/0
