# BFF → FastAPI. The browser never sees these; only Next route handlers do.
# Base URL of the IKIP API (Epic 3 service).
IKIP_API_URL=http://localhost:8000
# Server-held bearer token for the API (dev: mint one via POST /api/v1/auth/dev-token
# with AUTH_DEV_LOGIN=true on the API). In prod this is an Entra ID token / service identity.
IKIP_API_TOKEN=
# For /platform, use a token whose immutable subject UUID is present in the API's
# PLATFORM_OPERATOR_USER_IDS allowlist. A tenant-admin token is intentionally refused.
