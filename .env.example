# ─────────────────────────────────────────────────────────────────────────
# Example environment — copy to .env and fill in. NEVER put real secrets here.
#   cp .env.example .env
# .env is gitignored; .env.example (this file) is committed as documentation.
# ─────────────────────────────────────────────────────────────────────────

# Cloudflare R2 (object storage, S3-compatible) — ADR 0014
# Create an R2 API token (Object Read & Write, scoped to the bucket) to get the keys.
R2_ACCOUNT_ID=your-account-id
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=ikip-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AI (remote) — Azure OpenAI / Foundry (ADR 0007, 0010). Provisioned via Terraform:
# infrastructure/terraform/environments/dev (ADR 0021). Fill from `terraform output`.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Embedding vector dimension (ADR 0020). Default 512 (Matryoshka, fits Neon). Optional.
EMBEDDING_DIMENSIONS=512
# Texts per embeddings API call. Keep small on the low Azure S0 tier (429s); raise with
# more quota (see runbooks/dev-on-azure-cost-control.md). Optional, default 16.
EMBEDDING_BATCH_SIZE=16
# Chat generation (ADR 0022). gpt-5.4-mini is a reasoning model: tune CHAT_REASONING_EFFORT
# (minimal/low/medium/high), leave CHAT_TEMPERATURE unset. For a non-reasoning fallback
# (gpt-4.1-mini) you may set CHAT_TEMPERATURE instead. Both optional.
CHAT_REASONING_EFFORT=minimal
# CHAT_TEMPERATURE=

# LLMOps — Langfuse (ADR 0013). Cloud Hobby (free) for dev/MVP; EU region.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Story 5.4: traces store query HASHES + IDs, not raw prompts/content (NFR16). Set true
# ONLY to capture raw content in Langfuse (e.g. local debugging on non-sensitive data).
TELEMETRY_CAPTURE_CONTENT=false
# Story 5.6: infra metrics via OTel -> Grafana Cloud (free tier). Unset = metrics no-op.
# Values from Grafana Cloud -> Connections -> OTLP. Metrics carry only counts/latency/cost
# + labels, never query text (NFR16). See docs/runbooks/grafana-cloud-observability.md.
# Paste the three lines from Grafana Cloud -> Connections -> OTLP (they work from .env now):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:token)>
OTEL_SERVICE_NAME=ikip-api

# Story 6.4 — secrets & PII. Local uses .env; prod fetches from Azure Key Vault when set
# (managed identity, `keyvault` dep group). PII_SCRUB=true → Presidio if installed else a
# regex fallback; content is hashed/ID-only by default (NFR16).
# AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net/
PII_SCRUB=true

# Database — Neon serverless Postgres + pgvector (ADR 0015).
# Use the Neon pooled connection string (requires sslmode=require).
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
# Offline alternative (local Docker Postgres):
# DATABASE_URL=postgresql://ikip:ikip@localhost:5432/ikip

# Auth (Story 1.6) — JWT signing secret + dev-login flag.
# Generate a dev secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In prod, auth is Microsoft Entra ID (OIDC) — this HS256 secret is dev-only.
JWT_SECRET=
AUTH_DEV_LOGIN=true
# Comma-separated immutable IdP subject UUIDs allowed to manage all organizations.
# This capability is deliberately independent from tenant roles, including admin.
PLATFORM_OPERATOR_USER_IDS=

# Redis — JobQueue + Cache (ADR 0009 Redis note). Local Docker by default;
# or a Redis Cloud Free (30 MB) URL for a fully-managed dev setup.
REDIS_URL=redis://localhost:6379/0
# Redis Cloud example: redis://default:<password>@<host>:<port>
